{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:server"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 5173
    },
    {
      "name": "scenario-server",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/server && PORT=3101 ADMIN_IDS=1 BOT_TOKEN= PGLITE_DIR=.data/pglite-scenario SEED_DEMO_TEAMS=true npx tsx src/index.ts"
      ],
      "port": 3101,
      "autoPort": false
    },
    {
      "name": "scenario-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "API_PROXY_TARGET=http://localhost:3101 npm --workspace=@stem/web exec -- vite --port 5175 --strictPort"
      ],
      "port": 5175,
      "autoPort": false
    }
  ]
}
